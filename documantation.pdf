	% ==========================================================
	\section{مقدمه و صورت مسئله}
	% ==========================================================
	
	\subsection{زمینه و انگیزه پژوهش}
	توسعه مدل‌های پیش‌بینی هوا به طور سنتی در انحصار مدل‌های عددی پیش‌بینی هوا \lr{(NWP)} بود که با حل معادلات دیفرانسیل پیچیده جو کار می‌کنند. با ظهور یادگیری ماشین، این پرسش علمی مطرح شد که "آیا مدل‌های داده‌محور \lr{(Data-Driven)} می‌توانند با تکیه صرفاً بر داده‌های تاریخی و الگوهای آماری، جایگزین یا رقیب مدل‌های فیزیکی شوند؟"
	هدف اصلی این پژوهش، نه صرفاً ساخت یک ابزار پیش‌بینی، بلکه \textbf{مقایسه و ارتقای مدل‌های هوش مصنوعی و آماری} است تا مشخص شود حداکثر دقت قابل دستیابی بدون دخالت مدل‌های \lr{NWP} چقدر است و سیستم در کدام بخش‌ها و افق‌های زمانی دچار ناتوانی می‌شود.
	
	\subsection{صورت مسئله و چالش‌های مدل‌های داده‌محور}
	مسئله ما، پیش‌بینی متغیرهای جوی (مانند دما) برای ۵ کلان‌شهر ایران در دو افق کوتاه‌مدت (۲۴ ساعته) و میان‌مدت (۷ روزه) با استفاده از ۱۱ مدل مختلف است.
	در مسیر ارتقای این مدل‌ها، متوجه شدیم که تکیه صرف بر الگوریتم‌های یادگیری ماشین (مانند \code{XGBoost} یا \code{LightGBM}) در غیاب فیزیک اتمسفری، با چالش‌های بنیادین روبرو است:
	
	\begin{enumerate}[label=\arabic*.]
		\item \textbf{سقف دقت در کوتاه‌مدت:} مدل‌های \lr{ML} به دلیل درک هم‌خطی بین متغیرهای تاخیری \lr{(Lags)}، در افق ۲۴ ساعت عملکرد فوق‌العاده‌ای دارند و می‌توانند با مدل خط‌مبنا \lr{(Naïve)} و حتی \lr{NWP} رقابت کنند.
		\item \textbf{فروپاشی در افق دور (جایی که به \lr{NWP} نیاز داریم):} به محض عبور از افق ۴۸ ساعت، مدل‌های درختی به دلیل عدم توانایی در برون‌یابی روند \lr{(Extrapolation)} و انباشت خطا در پیش‌بینی بازگشتی، دچار سقوط شدید دقت می‌شوند و خطوط پیش‌بینی آن‌ها به سمت مقادیر ثابت یا غیرفیزیکی میل می‌کند \lr{(Flat-line Collapse)}.
	\end{enumerate}
	
	\subsection{رویکرد سیستم: ارتقا تا مرز فیزیک}
	برای پاسخ به این چالش‌ها و کشف مرزهای مدل‌های داده‌محور، ما یک معماری چندلایه طراحی کردیم:
	\begin{itemize}
		\item \textbf{ارتقای الگوریتم‌های \lr{ML}:} برای جلوگیری از فروپاشی مدل‌ها در ۷ روز آینده، استراتژی پیش‌بینی بازگشتی به \textbf{\lr{Direct Multi-Horizon}} (مدل‌سازی مستقل برای هر روز) تغییر یافت. همچنین از تکنیک \textbf{\lr{Anomaly Targeting}} (پیش‌بینی انحراف از میانگین اقلیمی) استفاده شد تا بارِ یادگیری فیزیک فصل‌ها از دوش مدل برداشته شود.
		\item \textbf{ترکیب نهایی با \lr{NWP} \lr{(MOS Blending)}:} پس از اعمال تمامی روش‌های ارتقای \lr{ML}، پذیرفتیم که مدل‌های داده‌محور در افق‌های میان‌مدت به سقف خود می‌رسند. به همین دلیل، \lr{Open-Meteo} (به عنوان نماینده مدل \lr{NWP}) را نه به عنوان رقیب، بلکه به عنوان یک ویژگی \lr{(Feature)} با خروجی \lr{ML} خودمان ترکیب کردیم \lr{(MOS Blending)}.
	\end{itemize}
	
	\subsection{هدف نهایی داکیومنت}
	این داکیومنت نشان می‌دهد که چگونه با ارتقای معماری مدل‌ها (مانند لایه ایمنی فصلی و پیش‌بینی مستقیم)، می‌توان به مدل‌های یادگیری ماشین استقلال داد تا در کوتاه‌مدت با دقت بالایی کار کنند، و در عین حال به صورت علمی مشخص کرد که در افق‌های زمانی دور، فیزیک اتمسفری \lr{(NWP)} تا چه حد حیاتی و غیرقابل حذف است.
	
	% ==========================================================
	\section{الزامات سیستم \lr{(System Requirements)}}
	% ==========================================================
	برای اجرای پایدار خط‌لوله مقایسه و ارتقای مدل‌ها، سیستم باید الزامات سخت‌گیرانه‌ای را در دو سطح عملکردی و غیرعملکردی برآورده سازد. این الزامات مستقیماً از چالش‌های ریاضی سری‌های زمانی و محدودیت‌های محیط اجرای \lr{R} نشأت می‌گیرند.
	
	\subsection{الزامات عملکردی \lr{(Functional Requirements)}}
	\begin{itemize}
		\item \textbf{دریافت و همگون‌سازی داده \lr{(Data Ingestion \& Harmonization)}:}
		\begin{itemize}
			\item سیستم باید قادر باشد داده‌های خام را از دو \lr{End-point} مجزا (\code{archive-api} و \code{forecast-api} در \lr{Open-Meteo}) فراخوانی کند.
			\item به دلیل تفاوت در ساختار خروجی \lr{JSON}، سیستم باید داده‌ها را به یک ساختار یکپارچه (\code{data.frame} با ستون‌های استاندارد) تبدیل کرده و زمان‌ها را به فرمت \code{POSIXct} با منطقه زمانی \code{Asia/Tehran} همگون سازد.
			\item مکانیزم ادغام باید به گونه‌ای باشد که در بازه‌های هم‌پوشانی (۱۰ روز اخیر)، داده‌های اخیرِ \lr{API} پیش‌بینی، داده‌های قدیمی‌تر آرشیو را با تکنیک مرتب‌سازی نزولی و \code{duplicated} بازنویسی کنند.
		\end{itemize}
		\item \textbf{بازسازی پیوستگی زمانی \lr{(Temporal Continuity Reconstruction)}:}
		\begin{itemize}
			\item سیستم باید یک «توری زمانی کامل» \lr{(Complete Hourly Grid)} با دستور \code{seq.POSIXt} بسازد.
			\item باید حفره‌های زمانی را با استفاده از درون‌یابی خطی (\code{zoo::na.approx}) برای داده‌های میانی و تکنیک حمل آخرین مشاهده (\code{zoo::na.locf} و \code{fromLast=TRUE}) برای ابتدا و انتهای سری زمانی پر کند تا هیچ شیفت زمانی در محاسبه لگ‌ها رخ ندهد.
		\end{itemize}
		\item \textbf{مهندسی ویژگی‌های ریاضی و فیزیکی \lr{(Feature Engineering)}:}
		\begin{itemize}
			\item سیستم باید ویژگی‌های تاخیری \lr{(Lags)} را در بازه‌های ۱، ۲، ۳، ۲۴، ۴۸ و ۷۲ ساعته محاسبه کند.
			\item باید قادر به محاسبه میانگین متحرک (\code{zoo::rollmean}) و انحراف معیار متحرک (\code{zoo::rollapply}) در پنجره‌های ۶ و ۲۴ ساعته باشد.
			\item سیستم موظف است چرخه‌های زمانی (ساعت و روز سال) را با تبدیل ریاضی سینوسی/کوسینوسی (\code{sin(2*pi*hour/24)}) رمزگذاری کند تا پیوستگی ریاضی حلقه‌های زمانی (مثلاً عبور از ساعت ۲۳ به ۰۰) حفظ شود.
		\end{itemize}
		\item \textbf{پشتیبانی از معماری‌های چندگانه پیش‌بینی \lr{(Multi-Strategy Forecasting)}:}
		\begin{itemize}
			\item سیستم باید برای افق ۲۴ ساعته از روش بازگشتی \lr{(Recursive)} و برای افق ۷ روزه از روش مستقیم \lr{(Direct Multi-Horizon با ۷ مدل مجزا)} پشتیبانی کند.
			\item باید قادر به تعویض متغیر هدف از دمای خام \lr{(Raw Temperature)} به ناهنجاری اقلیمی \lr{(Anomaly = Target - Climatology)} جهت کاهش بار یادگیری فصلی باشد.
		\end{itemize}
	\end{itemize}
	
	\subsection{الزامات غیرعملکردی \lr{(Non-Functional Requirements)}}
	\begin{itemize}
		\item \textbf{تضمین قطعی عدم نشت داده \lr{(Zero Data Leakage Guarantee)}:}
		\begin{itemize}
			\item بحرانی‌ترین الزام سیستم است. در زمان ساخت ماتریس ویژگی‌ها، سیستم باید به صورت صریح، متغیرهای خام هواشناسی (مانند \code{temp\_min}, \code{temp\_max}, \code{humidity}) را از مجموعه ویژگی‌ها (\code{feat\_cols}) استثنا کند، مگر آنکه هدف پیش‌بینی همان متغیر باشد.
			\item تقسیم داده‌ها \lr{(Train/Test Split)} باید به صورت کاملاً زمانی و متوالی \lr{(Chronological)} انجام شود و استفاده از هرگونه نمونه‌گیری تصادفی (\code{sample}) ممنوع باشد.
		\end{itemize}
		\item \textbf{مدیریت حافظه و کارایی محاسباتی \lr{(Memory \& Compute Efficiency)}:}
		\begin{itemize}
			\item با توجه به حجم بالای داده‌های ساعتی (بیش از ۳۵,۰۰۰ ردیف در هر ایستگاه)، سیستم باید از ساختارهای ماتریسی (\code{as.matrix}) برای تغذیه مدل‌های \lr{ML} استفاده کند.
			\item سیستم باید از ساختارهای بهینه حافظه مانند \code{xgb.DMatrix} و \code{lgb.Dataset} برای جلوگیری از کپی شدن مکرر داده‌ها در \lr{RAM} استفاده نماید.
		\end{itemize}
		\item \textbf{پایداری در برابر خطاهای زمان اجرا \lr{(Runtime Robustness)}:}
		\begin{itemize}
			\item تمامی فراخوانی‌های مدل‌ها باید توسط بلوک‌های \code{tryCatch} احاطه شوند تا شکست یک مدل (مثلاً عدم همگرایی \lr{ARIMA} یا کرش \lr{CatBoost}) منجر به توقف کل اپلیکیشن \lr{Shiny} نشود.
			\item سیستم باید یک مکانیزم مدل پشتیبان \lr{(Fallback Model)} داشته باشد تا در صورت کرش مدل اصلی، حداقل یک پیش‌بینی میانگین‌گیری شده (بازگشتی به الگوی روز قبل) ارائه دهد.
		\end{itemize}
		\item \textbf{قیدهای فیزیکی و اصلاح نویز \lr{(Physical Constraints \& Denoising)}:}
		\begin{itemize}
			\item سیستم باید قبل از تغذیه داده‌ها به مدل، نویزها را با تکنیک چارک \lr{(Monthly IQR Outlier Removal)} به تفکیک هر ماه حذف کند.
			\item خروجی نهایی مدل‌ها باید توسط لایه ایمنی \lr{(Safety Clamps)} محدود شود تا مقادیر پیش‌بینی شده از رکوردهای تاریخی همان بازه روز سال \lr{(Day of Year $\pm$ 15 days)} خارج نشوند.
			\item نرخ تغییرات روزانه \lr{(Rate of Change)} باید به نهایتاً ۳ درجه سانتی‌گراد در روز محدود \lr{(Smoothed)} شود تا از جهش‌های غیرفیزیکی در پیش‌بینی‌های مستقل \lr{(Direct Horizon)} جلوگیری گردد.
		\end{itemize}
		\item \textbf{یکپارچگی فرمت داده \lr{(Data Format Integrity)}:}
		\begin{itemize}
			\item سیستم موظف است پیش از ذخیره در \lr{CSV}، زمان‌ها را به رشته متنی استاندارد (\code{format(..., "\%Y-\%m-\%d \%H:\%M:\%S")}) تبدیل کند تا از باگ معروف پایه \lr{R} در حذف ساعت \code{00:00:00} (نیمه‌شب) جلوگیری شود. همچنین مدیریت \lr{Encoding} فارسی \lr{(\code{UTF-8})} برای نام ایستگاه‌ها در سیستم‌عامل ویندوز (\code{Sys.setlocale}) الزامی است.
		\end{itemize}
	\end{itemize}
	
	% ==========================================================
	\section{معماری خط‌لوله داده \lr{(Data Pipeline Architecture)}}
	% ==========================================================
	خط‌لوله داده در این سیستم به گونه‌ای طراحی شده است که فقدان داده‌های خام \lr{(Missing Data)} و تاخیر در به‌روزرسانی \lr{API}ها، تأثیری در پیوستگی ریاضی سری‌های زمانی نداشته باشد. این معماری از دو استراتژی کلیدی تشکیل می‌شود:
	
	\subsection{استراتژی دریافت ترکیبی \lr{(Hybrid API Ingestion Strategy)}}
	سامانه برای پوشش دادن بازه‌ای از سال ۲۰۲۱ تا همین لحظه، نیازمند فراخوانی هم‌زمان دو \lr{End-point} مجزا در \lr{Open-Meteo} است، زیرا داده‌های تاریخی بایگانی و داده‌های لحظه‌ای پیش‌بینی در سرورهای جداگانه‌ای نگهداری می‌شوند:
	\begin{itemize}
		\item \textbf{\lr{Archive API} (داده‌های تاریخی عمیق):} این بخش داده‌های ساعتی از سال ۲۰۲۱ تا ۶ روز پیش را ارائه می‌دهد. سیستم این داده‌ها را به عنوان ستون فقرات مدل‌سازی \lr{(Deep History)} دریافت می‌کند.
		\item \textbf{\lr{Forecast API} (داده‌های اخیر و زنده):} به دلیل تاخیر ۶ روزه در بایگانی، سیستم مجبور است ۱۶ روز اخیر را از \lr{API} پیش‌بینی دریافت کند تا داده‌ها تا همین لحظه کامل شود.
		\item \textbf{مدیریت تداخل \lr{(Conflict Resolution)}:} بازه‌ی ۱۰ روزه (از ۱۶ روز پیش تا ۶ روز پیش) در هر دو \lr{API} وجود دارد و مقادیر آن‌ها ممکن است به دلیل اصلاح مدل‌های عددی، تفاوت‌های جزئی داشته باشد. برای جلوگیری از ایجاد ردیف‌های تکراری و حفظ یکپارچگی، سیستم هر دو دیتافریم را با \code{rbind} ترکیب کرده، سپس بر اساس \code{timestamp} به صورت \textbf{نزولی} مرتب می‌کند. با اعمال تابع \code{duplicated}، اولین ردیف مشاهده شده (که به دلیل مرتب‌سازی نزولی، مربوط به \lr{Forecast API} و جدیدتر است) نگه داشته شده و ردیف‌های قدیمی‌ترِ آرشیو حذف می‌شوند. این تضمین می‌کند که همیشه دقیق‌ترین داده‌های لحظه‌ای جایگزین داده‌های بایگانی می‌شوند.
	\end{itemize}
	
	\subsection{منطق توری زمانی کامل \lr{(Complete Hourly Grid Logic)}}
	بزرگترین خطر در مدل‌سازی سری‌های زمانی ساعتی، وجود گپ‌های زمانی (مثلاً نبود داده ساعت \lr{03:00} یک روز) است. اگر این گپ‌ها اصلاح نشوند، توابعی مانند \code{dplyr::lag(df\$temperature, 24)} به جای گرفتن دمای ۲۴ ساعت قبل، دمای ۲۴ ردیف قبل را می‌گیرند که باعث فروپاشی کامل ساختار تاخیری \lr{(Lag Structure)} می‌شود.
	
	برای حل این مشکل، سیستم معماری «توری زمانی» را پیاده‌سازی می‌کند:
	\begin{enumerate}
		\item \textbf{تولید دنباله زمانی:} سیستم با استفاده از دستور \code{seq.POSIXt(min\_t, max\_t, by = "hour")} یک سری زمانی کامل و بدون نقص از ابتدای تا انتهای داده‌ها می‌سازد.
		\item \textbf{ادغام بیرونی \lr{(Outer/Left Join)}:} داده‌های خام دریافت شده از \lr{API} با این توری ترکیب می‌شوند (\code{merge(full\_grid, raw\_df, all.x = TRUE)}). این کار باعث می‌شود هر ساعتی که در \lr{API} غیب بوده، به عنوان یک ردیف با مقادیر \code{NA} در سیستم ثبت شود.
		\item \textbf{درون‌یابی ایمن \lr{(Safe Imputation)}:} سیستم سپس این مقادیر \code{NA} را با تکنیک‌های تخصصی بسته \code{zoo} پر می‌کند:
		\begin{itemize}
			\item \code{zoo::na.approx}: برای ساعات میانی، درون‌یابی خطی انجام می‌دهد تا شیب تغییر دما حفظ شود.
			\item \code{zoo::na.locf}: برای ساعات ابتدایی یا انتهایی داده‌ها که امکان درون‌یابی خطی وجود ندارد، آخرین مقدار معتبر را حمل می‌کند \lr{(Last Observation Carried Forward)}.
		\end{itemize}
	\end{enumerate}
	
	\subsection{استخراج و ایمن‌سازی داده‌های روزانه \lr{(Daily Aggregation \& Safety)}}
	پس از ساخت داده‌های ساعتی پیوسته، سیستم باید آن‌ها را برای پیش‌بینی ۷ روزه به داده روزانه (شامل \code{temp\_max} و \code{temp\_min}) تبدیل کند.
	\begin{itemize}
		\item \textbf{گروه‌بندی و تجمیع:} سیستم داده‌ها را بر اساس تاریخ (\code{date\_only}) گروه‌بندی کرده و بیشینه و کمترین دما را استخراج می‌کند.
		\item \textbf{مدیریت مقادیر غیرمجاز \lr{(Inf/-Inf Handling)}:} اگر در یک روز تمام ۲۴ ساعت دما \code{NA} باشد، تابع \code{max(..., na.rm=TRUE)} در زبان \lr{R} مقدار \code{-Inf} (منفی بی‌نهایت) برمی‌گرداند که موتور \lr{XGBoost} و \lr{ARIMA} را نابود می‌کند. سیستم با استفاده از شرط \code{ifelse(all(is.na(...)), NA\_real\_, max(...))} این مقادیر بی‌نهایت را پیش از ذخیره به \code{NA} تبدیل می‌کند.
		\item \textbf{حفظ یکپارچگی فرمت در \lr{CSV}:} برای جلوگیری از باگ معروف پایه \lr{R} در تابع \code{write.csv} که زمان‌های دقیقاً روی نیمه‌شب (\code{00:00:00}) را به تاریخ خالی تبدیل می‌کند، سیستم پیش از ذخیره، تمام زمان‌ها را به رشته متنی استاندارد \code{format(timestamp, "\%Y-\%m-\%d \%H:\%M:\%S")} تبدیل می‌کند تا فرمت هنگام لود مجدد در اپلیکیشن \lr{Shiny} به هم نریزد.
	\end{itemize}
	
	% ==========================================================
	\section{مدل داده و مهندسی ویژگی \lr{(Data Model \& Feature Engineering)}}
	% ==========================================================
	یکی از چالش‌های اصلی در استفاده از مدل‌های یادگیری ماشین (مانند \lr{XGBoost} یا \lr{Random Forest}) برای پیش‌بینی سری‌های زمانی، درک مفاهیم فیزیکی و چرخه‌های طبیعی توسط این مدل‌هاست. از آنجا که درختان تصمیم ذاتاً قادر به درک مفاهیم پیوسته مانند زمان یا فصل نیستند، سیستم باید پیش از تغذیه داده‌ها به مدل، یک سری \lr{transformations} ریاضی و فیزیکی روی آن‌ها اعمال کند. این فرآیند در سه لایه اصلی انجام می‌شود:
	
	\subsection{پاک‌سازی پیشرفته و حذف نویز \lr{(Advanced Cleaning \& Denoising)}}
	داده‌های خام هواشناسی معمولاً حاوی نویزهای ناشی از خطای سنسورها یا قطعی‌های لحظه‌ای هستند. اگر این نویزها وارد آموزش مدل شوند، مدل ممکن است روی یک داده پرت \lr{(Outlier)} یاد بگیرد که دما باید ناگهان ۱۰ درجه سقوط کند، که در پیش‌بینی آینده منجر به جهش‌های غیرفیزیکی می‌شود.
	\begin{itemize}
		\item \textbf{درون‌یابی خطی \lr{(Linear Interpolation)}:} برای گپ‌های کوچک زمانی، سیستم از \code{zoo::na.approx} استفاده می‌کند تا با رسم یک خط مستقیم بین دو نقطه معلوم، مقادیر گمشده را تخمین بزند.
		\item \textbf{حذف داده‌های پرت با \lr{IQR} ماهانه \lr{(Monthly IQR Outlier Removal)}:} از آنجا که دمای تابستان و زمستان به شدت متفاوت است، نمی‌توان یک آستانه ثابت برای حذف نویز تعیین کرد. سیستم به صورت پویا، داده‌ها را بر اساس «ماه» گروه‌بندی کرده و سپس برای هر ماه، بازه بین چارک اول \lr{(Q1)} و سوم \lr{(Q3)} را محاسبه می‌کند. هر دمایی که از بازه \lr{$[Q1 - 1.5 \times IQR, Q3 + 1.5 \times IQR]$} خارج باشد، به عنوان نویز شناسایی شده و به \code{NA} تبدیل می‌شود. سپس این \code{NA}های جدید با درون‌یابی پر می‌شوند.
	\end{itemize}
	
	\subsection{قیود فیزیکی و شاخص‌های اقلیمی \lr{(Physical Constraints \& Indices)}}
	برای کمک به مدل‌های درختی تا منطق فیزیکی جو را درک کنند، ویژگی‌های جدیدی ساخته شدند:
	\begin{itemize}
		\item \textbf{قید منطقی \lr{$T_{min} \leq T_{max}$}:} سیستم پس از پیش‌بینی مقادیر بیشینه و کمینه، یک لایه ایمنی ریاضی اعمال می‌کند (\code{pmin} و \code{pmax}) تا تضمین شود دمای کمینه هرگز از دمای بیشینه بیشتر نشود.
		\item \textbf{تقریب تابش خورشید (\code{solar\_rad}):} به جای اینکه فقط ساعت روز را به مدل بدهیم، شدت تابش خورشید را با فرمول مثلثاتی مدل کردیم:
		\begin{equation}
			Solar\_Angle = \sin\left(2\pi \frac{Hour - 6}{24}\right)
		\end{equation}
		مقادیر منفی (شب‌ها) صفر در نظر گرفته شده و در یک ضریب تصحیح فصلی \lr{$(1 + \cos(2\pi \frac{Day\_of\_Year - 172}{365}))$} ضرب می‌شوند تا تابستان‌ها شدت تابش بیشتر شود.
		\item \textbf{قانون بارش (\code{rain\_prob\_rule}):} یک شرط فیزیکی باینری (۰ و ۱) تعریف شد: اگر رطوبت نسبی بالای ۸۰\% و فشار سطحی زیر ۱۰۱۰ هکتوپاسکال بود، احتمال بارش ۱ است. این ویژگی به مدل کمک می‌کند الگوهای پیش از رخداد بارش را شناسایی کند.
	\end{itemize}
	
	\subsection{ریاضیات متغیرها و رمزگذاری زمانی \lr{(Mathematics \& Cyclical Encoding)}}
	زمان یک متغیر چرخه‌ای \lr{(Cyclical)} است. مثلاً ساعت ۲۳ بسیار به ساعت ۰۰ نزدیک‌تر است تا به ساعت ۱۲. اما اگر ساعت را به صورت یک عدد صحیح (۱ تا ۲۴) به مدل بدهیم، مدل گمان می‌کند ساعت ۲۴ از همه دورتر است!
	\begin{itemize}
		\item \textbf{رمزگذاری سینوسی-کوسینوسی \lr{(Sine/Cosine Encoding)}:} سیستم برای حفظ پیوستگی ریاضی حلقه‌های زمانی، ساعت، روز هفته و روز سال را به مختصات دکارتی تبدیل می‌کند:
		\begin{equation}
			X_{hour} = \sin\left(2\pi \frac{hour}{24}\right), \quad Y_{hour} = \cos\left(2\pi \frac{hour}{24}\right)
		\end{equation}
		این کار باعث می‌شود مدل‌های \lr{ML} بفهمند که پس از ساعت ۲۴، دوباره به ساعت ۰ نزدیک می‌شویم.
		\item \textbf{متغیرهای تاخیری \lr{(Time Lags)}:} برای اینکه مدل بتواند روند را ببیند، مقادیر گذشته متغیر هدف به عنوان ویژگی‌های جدید \lr{(Lags)} ساخته می‌شوند. برای داده‌های ساعتی لگ‌های ۱، ۲، ۳، ۲۴ (دیروز در همین ساعت)، ۴۸ و ۷۲ ساعته، و برای داده‌های روزانه لگ‌های ۱، ۲، ۳، ۷ (هفته گذشته) و ۱۴ روزه محاسبه می‌شوند.
		\item \textbf{آمار لغزان \lr{(Rolling Statistics)}:} برای درک "روند کلی" به جای یک لحظه خاص، سیستم میانگین متحرک (\code{rollmean}) در پنجره‌های ۶ ساعته، ۲۴ ساعته و ۳۰ روزه، و همچنین انحراف معیار متحرک (\code{rollapply(FUN=sd)}) را محاسبه می‌کند تا مدل میزان نوسانات اخیر را درک کند.
		\item \textbf{نرخ تغییرات \lr{(Rate of Change)}:} برای مدل‌سازی جهت حرکت هوا، سیستم تفاضل مقادیر ساخت (مانند \code{temp\_change\_1d = temp - lag\_1}) تا مدل بفهمد هوا در حال گرم شدن یا سرد شدن است.
	\end{itemize}
	
	% ==========================================================
	\section{روش‌شناسی و الگوریتم‌ها \lr{(Methodology \& Algorithms)}}
	% ==========================================================
	در این سامانه، ۱۱ مدل مختلف در دو خانواده اصلی آماری و یادگیری ماشین پیاده‌سازی شده‌اند. هدف از تنوع مدل‌ها، یافتن نقطه طلایی بین دقت در کوتاه‌مدت (که قلمرو مدل‌های \lr{ML} است) و پایداری روند در بلندمدت (که قلمرو مدل‌های آماری است) می‌باشد.
	
	\subsection{چرا الگوریتم‌های درختی \lr{(XGBoost / LightGBM / CatBoost)}؟}
	مدل‌های مبتنی بر درخت تصمیم، در سال‌های اخیر به ستاره‌های پیش‌بینی سری‌های زمانی تبدیل شده‌اند. دلیل انتخاب این مدل‌ها در این پروژه دو ویژگی ریاضی کلیدی است:
	\begin{itemize}
		\item \textbf{مقاومت در برابر هم‌خطی شدید \lr{(Multicollinearity)}:} در پیش‌بینی دما، متغیرهای تاخیری \lr{(Lags)} با یکدیگر هم‌خطی شدید دارند (مثلاً لگ ۲۴ ساعته با لگ ۴۸ ساعته همبستگی بالایی دارد). در مدل‌های کلاسیک مانند رگرسیون خطی، این هم‌خطی باعث ناپایداری ضرایب و خطای بالا می‌شود. اما مدل‌های درختی ذاتاً به هم‌خطی مقاوم هستند و به سادگی بهترین نقاط شکست \lr{(Split Points)} را بین لگ‌ها انتخاب می‌کنند.
		\item \textbf{درک تعاملات غیرخطی \lr{(Non-linear Interactions)}:} مدل‌های درختی می‌توانند روابط پیچیده‌ای را که در معادلات خطی قابل بیان نیست، درک کنند؛ مثلاً "اگر رطوبت بالای ۸۰\% باشد و فشار در حال افت باشد و دمای دیروز گرم بوده باشد، دمای امروز افت می‌کند".
		\item \textbf{چالش برون‌یابی \lr{(Extrapolation Challenge)}:} تنها ضعف ذاتی این مدل‌ها این است که نمی‌توانند مقادیر بزرگتر از محدوده آموزشی خود را پیش‌بینی کنند (روند صعودی تابستان را به خوبی درک نمی‌کنند). سیستم ما این ضعف را با تکنیک \textbf{\lr{Anomaly Targeting}} (پیش‌بینی انحراف از میانگین اقلیمی) جبران می‌کند تا مدل فقط نوسانات کوتاه‌مدت را یاد بگیرد، نه روند فصلی را.
	\end{itemize}
	
	\subsection{چرا مدل \lr{Prophet} (بیزی)؟}
	مدل \lr{Prophet} توسعه‌یافته توسط فیس‌بوک (متا)، یک رویکرد کاملاً متفاوت بر اساس مدل‌سازی بیزی و جمعی \lr{(Additive Modeling)} دارد.
	\begin{itemize}
		\item \textbf{استخراج خودکار روند و فصلیت \lr{(Trend \& Seasonality)}:} برخلاف مدل‌های \lr{ML} که نیاز به ساخت دستی ویژگی‌های سینوسی/کوسینوسی دارند، \lr{Prophet} با استفاده از سری‌های فوریه \lr{(Fourier Series)} به صورت خودکار چرخه‌های روزانه، هفتگی و سالانه را از داده استخراج می‌کند.
		\item \textbf{انعطاف‌پذیری در برابر نویز و داده گمشده:} این مدل بسیار مقاوم است و در افق‌های ۷ روزه، به دلیل درک ذاتی روند \lr{(Trend)}، خروجی‌های بسیار نرم‌تر و منطقی‌تری نسبت به \lr{XGBoost} ارائه می‌دهد. سیستم ما از \lr{Prophet} به عنوان یکی از پایه‌های اصلی در مدل ترکیبی \lr{(Ensemble)} برای متعادل کردن جهش‌های مدل‌های درختی استفاده می‌کند.
	\end{itemize}
	
	\subsection{چرا مدل‌های آماری کلاسیک \lr{(SARIMA / TBATS)}؟}
	مدل‌های \lr{ARIMA} و خانواده آن‌ها برای مدل‌سازی خودهمبستگی \lr{(Autocorrelation)} طراحی شده‌اند.
	\begin{itemize}
		\item \textbf{\lr{TBATS}:} به دلیل توانایی منحصر‌به‌فردش در مدل‌سازی فصلیت‌های چندگانه و غیرصحیح (مثلاً فصل ۳۶۵.۲۵ روزه)، برای داده‌های اقلیمی بسیار مناسب است.
		\item \textbf{\lr{SARIMA}:} با اضافه کردن ترم‌های فصلی و استفاده از تبدیل فوریه به عنوان متغیر کمکی \lr{(Fourier XREG)}، این مدل توانست چرخه‌های هفتگی را به خوبی درک کند و در بنچمارک ۲۴ ساعته با مدل خط‌مبنا \lr{(Naïve)} رقابت کند.
	\end{itemize}
	
	\subsection{مدل خط‌مبنا \lr{(Naïve Baseline)}}
	پیش‌بینی "دمای فردا برابر دمای امروز" \lr{(Persistence Model)}. وجود این مدل در سیستم یک الزام علمی است. \lr{Naïve} نشان می‌دهد که "چقدر از تغییرات دما صرفاً به دلیل ماندگاری جرم هوا \lr{(Persistence)} است". اگر مدل‌های پیچیده نتوانند از \lr{Naïve} پیشی بگیرند، یعنی ساختار پیچیده‌سازی بی‌فایده بوده است.
	
	\subsection{موتور ترکیبی هوشمند \lr{(AutoML Ensemble)}}
	از آنجا که هیچ مدلی در همه شرایط برتر نیست، سیستم یک لایه ترکیبی \lr{(Ensemble)} طراحی کرده است:
	\begin{enumerate}
		\item \textbf{فیلتر مدل‌های ضعیف:} مدلی که خطای آن بسیار بالاست حذف می‌شود.
		\item \textbf{وزن‌دهی نرم \lr{(Softmax Weighting)}:} به مدل‌های قوی‌تر \lr{(RMSE} کمتر) وزن نمایی بیشتری داده می‌شود:
		\begin{equation}
			w_i = \frac{e^{-\beta \cdot RMSE_i}}{\sum e^{-\beta \cdot RMSE_j}}
		\end{equation}
		\item \textbf{ترکیب خروجی:} پیش‌بینی نهایی، میانگین وزنی خروجی مدل‌های قوی است. این کار باعث می‌شود خطاهای یک‌طرفه مدل‌ها خنثی شده و دقت ترکیبی همیشه از تک‌تک مدل‌ها بالاتر باشد.
	\end{enumerate}
	
	% ==========================================================
	\section{استراتژی اعتبارسنجی \lr{(Validation Strategy)}}
	% ==========================================================
	اعتبارسنجی در پروژه‌های سری زمانی \lr{(Time-Series)} با یادگیری ماشین سنتی کاملاً متفاوت است. بزرگترین خطای مهندسی در این حوزه، استفاده از روش‌های تصادفی (مثل \lr{K-Fold Cross-Validation}) است که باعث نشت داده \lr{(Data Leakage)} از آینده به گذشته می‌شود. سیستم ما برای جلوگیری از این فاجعه، یک استراتژی اعتبارسنجی کاملاً زمان‌محور را پیاده‌سازی کرده است.
	
	\subsection{روش تقسیم متوالی و پنجره لغزان \lr{(Chronological Split \& Rolling Window)}}
	\begin{itemize}
		\item \textbf{منع نمونه‌گیری تصادفی:} سیستم به هیچ وجه از توابعی مانند \code{sample} برای تقسیم داده‌ها استفاده نمی‌کند. تقسیم داده‌ها \lr{(Train/Test Split)} به صورت ۱۰۰\% متوالی \lr{(Chronological)} انجام می‌شود. به این معنا که داده‌های گذشته همیشه بخش آموزش \lr{(Train)} و داده‌های اخیر همیشه بخش آزمون \lr{(Test)} را تشکیل می‌دهند. این دقیقاً شرایط واقعی پیش‌بینی هوا را شبیه‌سازی می‌کند.
		\item \textbf{تحلیل پایداری در پنجره‌های زمانی \lr{(Rolling Window Stability)}:} یک مدل ممکن است در یک روز خاص خوب عمل کند اما در روز دیگر شکست بخورد. سیستم برای ارزیابی پایداری، داده‌های آزمون (مثلاً ۲۴ ساعت آینده) را به ۳ پنجره زمانی مجزا تقسیم می‌کند. سپس خطای مدل را در هر پنجره به صورت جداگانه محاسبه کرده و "انحراف معیار رتبه‌بندی" \lr{(Rank SD)} را به دست می‌آورد. مدلی که در هر ۳ پنجره عملکرد ثابتی داشته باشد، امتیاز پایداری بالاتری می‌گیرد.
	\end{itemize}
	
	\subsection{معیارهای ارزیابی ریاضی \lr{(Evaluation Metrics)}}
	برای مقایسه ۱۲ مدل، سیستم به یک معیار واحد اتکا ندارد، زیرا هر معیار ضعفی از مدل را پنهان می‌کند. ما از ترکیب ۵ معیار آماری استفاده می‌کنیم:
	
	\begin{itemize}
		\item \textbf{\lr{RMSE} (جذر میانگین مربعات خطا):}
		\begin{equation}
			RMSE = \sqrt{\frac{1}{n}\sum_{i=1}^{n} (y_i - \hat{y}_i)^2}
		\end{equation}
		این معیار به شدت به خطاهای بزرگ \lr{(Outlier Errors)} حساس است. در پیش‌بینی آب‌وهوا، یک خطای فاجعه‌بار (مثلاً ۱۰ درجه اشتباه) بسیار خطرناک‌تر از چند خطای کوچک است. \lr{RMSE} این خطاهای بزرگ را به شدت جریمه می‌کند.
		\item \textbf{\lr{MAE} (میانگین قدر مطلق خطا):}
		\begin{equation}
			MAE = \frac{1}{n}\sum_{i=1}^{n} |y_i - \hat{y}_i|
		\end{equation}
		برخلاف \lr{RMSE}، به خطاهای بزرگ جریمه نمایی نمی‌دهد و نشان‌دهنده میانگین خطای واقعی مدل به درجه سانتی‌گراد است. این معیار برای درک شهودی عملکرد مدل بسیار کاربردی است.
		\item \textbf{\lr{$R^2$} (ضریب تعیین):} نشان می‌دهد که مدل ما چقدر توانسته واریانس داده‌ها را توضیح دهد. نکته مهم این است که در داده‌های دارای روند (مثل دمای فصلی)، حتی مدل خط‌مبنا \lr{(Naïve)} هم \lr{$R^2$} بالایی می‌گیرد. بنابراین، تکیه صرف بر \lr{$R^2$} گمراه‌کننده است.
		\item \textbf{\lr{MAPE} و \lr{SMAPE} (خطاهای درصدی):} از آنجا که دما ممکن است به صفر یا مقادیر منفی نزدیک شود، \lr{MAPE} دچار ابهام ریاضی می‌شود. سیستم از معیار اصلاح‌شده \lr{SMAPE} استفاده می‌کند که مخرج آن مجموع قدر مطلق پیش‌بینی و واقعیت است، تا مدل در نزدیکی صفر بی‌نهایت نشود.
	\end{itemize}
	
	\subsection{نمره ترکیبی \lr{(Composite Score)}}
	از آنجا که مقایسه ۱۲ مدل بر اساس ۵ معیار متفاوت برای کاربر نهایی گیج‌کننده است، سیستم یک "نمره ترکیبی" \lr{(Composite Score)} محاسبه می‌کند:
	این نمره با نرمال‌سازی \lr{(Min-Max Scaling)} تمام معیارها در بازه ۰ تا ۱ و اعمال وزن‌های متفاوت (۲۵\% برای \lr{RMSE}، ۲۰\% برای \lr{MAE} و...) به دست می‌آید. عدد نمره ترکیبی هرچه به صفر نزدیک‌تر باشد، نشان‌دهنده برتری همه‌جانبه مدل است. این نمره مبنای اصلی رتبه‌بندی لیدربرد \lr{(Leaderboard)} و انتخاب مدل پیشنهادی \lr{(AutoML)} قرار می‌گیرد.
	
	% ==========================================================
	\section{تحلیل نتایج و شواهد \lr{(Analysis of Results \& Findings)}}
	% ==========================================================
	پس از اجرای پایپ‌لاین کامل و ارزیابی ۱۲ مدل بر روی ۵ کلان‌شهر ایران، نتایج به دست آمده شواهد روشنی از نقاط قوت و ضعف الگوریتم‌های داده‌محور \lr{(Data-Driven)} در پیش‌بینی جوی ارائه می‌دهد. یافته‌های کلیدی این پژوهش در سه محور زیر خلاصه شده‌اند:
	
	\subsection{پارادوکس دقت در کوتاه‌مدت (تسلط مدل‌های آماری و خط‌مبنا)}
	یکی از شگفت‌انگیزترین نتایج بنچمارک ۲۴ ساعته، رقابت بسیار نزدیک مدل‌های پیچیده یادگیری ماشین با ساده‌ترین مدل موجود، یعنی \textbf{\lr{Naïve} (خط‌مبنا)} و \textbf{\lr{SARIMA}} بود.
	\begin{itemize}
		\item \textbf{دلیل علمی (خاصیت ماندگاری جو):} جرم هوا در یک منطقه در کوتاه‌مدت (۲۴ ساعت) به سرعت تغییر نمی‌کند. بنابراین، دمای ساعت ۱۴:۰۰ فردا تقریباً برابر با دمای ساعت ۱۴:۰۰ امروز است. مدل \lr{Naïve} دقیقاً همین ثبات را مدل می‌کند.
		\item \textbf{نتیجه:} مدل‌های \lr{ML} (مانند \lr{XGBoost}) با وجود داشتن ده‌ها ویژگی (رطوبت، باد، لگ‌ها)، به سختی توانستند از مدل \lr{Naïve} پیشی بگیرند. این نشان می‌دهد که در افق‌های زیر ۲۴ ساعت، پیچیدگی‌سازی مدل‌های یادگیری ماشین سود چندانی ندارد و مدل‌های آماریِ درک‌کننده چرخه روزانه (مثل \lr{SARIMA}) کارایی بسیار بالایی دارند. با این حال، مدل ترکیبی \lr{(Ensemble)} توانست با ترکیب خروجی‌ها، به طور میانگین از تک‌تک این مدل‌ها عملکرد بهتری ارائه دهد.
	\end{itemize}
	
	\subsection{فروپاشی مدل‌های \lr{ML} در افق میان‌مدت و اثربخشی معماری جدید}
	هنگام استفاده از روش کلاسیک \lr{(Recursive Forecasting)} برای پیش‌بینی ۷ روز آینده، مدل‌های درختی دچار یک فاجعه ریاضی شدند:
	\begin{itemize}
		\item \textbf{پدیده خط صاف \lr{(Flat-line Collapse)}:} به دلیل عدم توانایی در برون‌یابی \lr{(Extrapolation)} و انباشت خطا، خروجی مدل‌هایی مثل \lr{LightGBM} و \lr{CatBoost} از روز سوم به بعد به یک عدد ثابت میل کرد یا در تابستان به سمت ۱۵- درجه سقوط کرد (چون مدل به داده‌های زمستان وزن داده بود).
		\item \textbf{اثربخشی راهکارها:} اعمال معماری \textbf{\lr{Direct Multi-Horizon}} (۷ مدل مستقل) زنجیره انباشت خطا را قطع کرد. اما شاهکار پروژه، استفاده از \textbf{\lr{Anomaly Targeting}} بود. وقتی هدف مدل از «پیش‌بینی دمای خام» به «پیش‌بینی انحراف از میانگین اقلیمی» تغییر کرد، مدل‌های \lr{ML} دیگر نیازی به درک فصل‌ها نداشتند و توانستند با دقت بالایی نوسانات کوتاه‌مدت جو را پیش‌بینی کنند. در نهایت، لایه ایمنی فصلی \lr{(Seasonal Clamping)} باعث شد تا هیچ خروجی غیرفیزیکی به کاربر نمایش داده نشود.
	\end{itemize}
	
	\subsection{مرز دقت مدل‌های داده‌محور و ضرورت مدل‌های \lr{NWP}}
	پرسش اصلی پروژه این بود: \textit{"حداکثر دقت بدون دخالت فیزیک اتمسفری چقدر است و کجا به \lr{NWP} نیاز داریم؟"}
	شواهد نشان داد:
	\begin{itemize}
		\item \textbf{افق ۱ تا ۳ روز:} مدل‌های داده‌محور (به خصوص مدل ترکیبی ما) کاملاً مستقل هستند و می‌توانند با دقت بالا \lr{($R^2 > 0.90$)} با مدل‌های \lr{NWP} رقابت کنند. در این بازه، یادگیری از الگوهای محلیِ گذشته کفایت می‌کند.
		\item \textbf{افق ۴ تا ۷ روز:} اینجاست که مدل‌های داده‌محور به سقف خود می‌رسند. تغییرات جبهه‌های هوایی و ورود جرم‌های هوایی جدید (که در داده‌های تاریخی موجود نیستند) باعث می‌شود دقت \lr{ML} به شدت افت کند.
		\item \textbf{راه‌حل نهایی \lr{(MOS Blending)}:} سیستم نشان داد که بهترین استراتژی برای روزهای ۴ تا ۷، رقابت \lr{ML} با \lr{NWP} نیست، بلکه \textbf{ترکیب آن‌هاست}. با میانگین‌گیری ۵۰-۵۰ بین خروجی \lr{ML} (که الگوهای محلی را می‌شناسد) و خروجی \lr{Open-Meteo} (که فیزیک اتمسفر را حل کرده است)، توانستیم یک پیش‌بینی به شدت پایدار و دقیق برای ۷ روز آینده تولید کنیم.
	\end{itemize}
	
	\subsection{مصالحه سرعت و دقت \lr{(Trade-off Analysis)}}
	نمودارهای رتبه‌بندی نشان داد که مدل‌هایی مانند \lr{CatBoost} و \lr{XGBoost} با وجود دقت بالا، زمان اجرای نسبتاً طولانی (چند ثانیه) دارند. در مقابل، مدل \lr{Naïve} در کسری از ثانیه \lr{(0.01s)} اجرا می‌شود. این مصالحه به سیستم پیشنهادی \lr{(AutoML)} اجازه داد تا بسته به نیاز کاربر (اولویت با سرعت یا اولویت با دقت)، مدل مناسب را پیشنهاد دهد.
	
	\vspace{1cm}
	\begin{center}
		\textbf{جمعبندی نهایی داکیومنت:}
	\end{center}
	این پروژه نشان داد که یادگیری ماشین جایگزین مطلق فیزیک اتمسفری نیست؛ بلکه مکمل آن است. با مهندسی ویژگی دقیق و معماری‌های هدفمند (مانند \lr{Anomaly Targeting})، می‌توان مدل‌های \lr{ML} را تا مرز ۳ روز آینده به رقابت با \lr{NWP} واداشت، اما برای پایداری در افق‌های ۷ روزه، اتکا به ترکیب هوشمندانه \lr{ML} و \lr{NWP} \lr{(MOS Blending)} تنها راه‌حل عملیاتی و علمی است.
	
